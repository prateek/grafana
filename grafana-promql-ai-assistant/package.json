{
  "name": "grafana-promql-ai-assistant",
  "version": "1.0.0",
  "description": "Chrome extension that augments Grafana's Prometheus query builder with an AI assistant",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.{ts,html,css}\""
  },
  "keywords": [
    "chrome-extension",
    "grafana",
    "prometheus",
    "promql",
    "ai-assistant"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/ui": "^1.6.0",
    "eslint": "^8.57.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5",
    "vite": "^5.2.0",
    "vite-plugin-static-copy": "^1.0.4",
    "vitest": "^1.6.0"
  }
}
