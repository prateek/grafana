{
  "name": "grafana-promql-ai-assistant-extension",
  "version": "0.1.0",
  "description": "Chrome extension that augments Grafana's Prometheus query builder with an AI assistant overlay.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "dev": "node ./scripts/build.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write \"{src,scripts,tests}/**/*.{ts,js,json,css,html,md}\""
  },
  "devDependencies": {
    "@testing-library/dom": "^10.2.0",
    "@types/chrome": "^0.0.274",
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "esbuild": "^0.24.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "fs-extra": "^11.2.0",
    "jsdom": "^24.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.1"
  }
}
