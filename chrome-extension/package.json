{
  "name": "grafana-prometheus-ai-assistant",
  "version": "1.0.0",
  "description": "Chrome extension that augments Grafana's Prometheus query builder with an AI Assistant",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.{ts,css,html,json}\"",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "grafana",
    "prometheus",
    "promql",
    "ai-assistant",
    "chrome-extension"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.12.7",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "happy-dom": "^14.7.1",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5",
    "vite": "^5.2.10",
    "vite-plugin-static-copy": "^1.0.2",
    "vitest": "^1.5.0"
  }
}
